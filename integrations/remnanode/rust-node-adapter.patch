+test('dynamic add and remove retry a failed reload even after the file was staged', async () => {
+    const dir = await mkdtemp(join(tmpdir(), 'octo-rust-retry-'));
+    process.env.RUST_REALITY_BASE_CONFIG = join(dir, 'base.json');
+    process.env.RUST_REALITY_ACTIVE_CONFIG = join(dir, 'active.json');
+    process.env.RUST_REALITY_MANAGEMENT_SOCKET = join(dir, 'management.sock');
+    process.env.RUST_REALITY_CURSOR = join(dir, 'cursor.json');
+    const uuid = '11111111-1111-4111-8111-111111111111';
+    try {
+        await writeFile(
+            process.env.RUST_REALITY_ACTIVE_CONFIG,
+            JSON.stringify({ role: 'entry', reality: { sharedShortIds: ['aabb'] }, users: [] }),
+        );
+        const service = new RustCoreService();
+        service.writeValidated = async (config) =>
+            writeFile(process.env.RUST_REALITY_ACTIVE_CONFIG, JSON.stringify(config));
+        const reloads = [];
+        service.reload = async (ids) => {
+            reloads.push(ids);
+            if (reloads.length === 1 || reloads.length === 3) throw new Error('SIGHUP failed');
+        };
+        await assert.rejects(service.addVlessUser('5197', uuid), /SIGHUP failed/);
+        assert.equal(
+            await service.addVlessUser('5197', uuid),
+            false,
+            'same staged identity triggers retry',
+        );
+        await assert.rejects(service.removeUser('5197'), /SIGHUP failed/);
+        await service.removeUser('5197');
+        assert.deepEqual(reloads, [[5197], [5197], [], []]);
+    } finally {
+        await rm(dir, { recursive: true, force: true });
+        for (const key of [
+            'RUST_REALITY_BASE_CONFIG',
+            'RUST_REALITY_ACTIVE_CONFIG',
+            'RUST_REALITY_MANAGEMENT_SOCKET',
+            'RUST_REALITY_CURSOR',
+        ])
+            delete process.env[key];
+    }
+});
+
+test('batch retries a staged generation after a reload failure with an older applied config', async () => {
+    const dir = await mkdtemp(join(tmpdir(), 'octo-rust-batch-retry-'));
+    process.env.RUST_REALITY_BASE_CONFIG = join(dir, 'base.json');
+    process.env.RUST_REALITY_ACTIVE_CONFIG = join(dir, 'active.json');
+    process.env.RUST_REALITY_MANAGEMENT_SOCKET = join(dir, 'management.sock');
+    process.env.RUST_REALITY_CURSOR = join(dir, 'cursor.json');
+    const uuid1 = '11111111-1111-4111-8111-111111111111';
+    const uuid2 = '22222222-2222-4222-8222-222222222222';
+    try {
+        await writeFile(
+            process.env.RUST_REALITY_ACTIVE_CONFIG,
+            JSON.stringify({ role: 'entry', reality: { sharedShortIds: ['aabb'] }, users: [] }),
+        );
+        const service = new RustCoreService();
+        service.isOnline = async () => true;
+        service.writeValidated = async (config) =>
+            writeFile(process.env.RUST_REALITY_ACTIVE_CONFIG, JSON.stringify(config));
+        const reloads = [];
+        service.reload = async (ids) => {
+            reloads.push(ids);
+            if (reloads.length === 2) throw new Error('SIGHUP failed');
+        };
+        assert.deepEqual(await service.syncBatchUsers([{ username: '5197', uuid: uuid1 }]), [
+            '5197',
+        ]);
+        await assert.rejects(
+            service.syncBatchUsers([{ username: '10521', uuid: uuid2 }]),
+            /SIGHUP failed/,
+        );
+        assert.deepEqual(
+            await service.syncBatchUsers([{ username: '10521', uuid: uuid2 }]),
+            [],
+            'retry has no logical user change',
+        );
+        assert.deepEqual(reloads, [[5197], [5197, 10521], [5197, 10521]]);
+    } finally {
+        await rm(dir, { recursive: true, force: true });
+        for (const key of [
+            'RUST_REALITY_BASE_CONFIG',
+            'RUST_REALITY_ACTIVE_CONFIG',
+            'RUST_REALITY_MANAGEMENT_SOCKET',
+            'RUST_REALITY_CURSOR',
+        ])
+            delete process.env[key];
+    }
+});
