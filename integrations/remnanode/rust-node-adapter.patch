+test('imports advertised panel short IDs when the entry template has none', async () => {
+    const dir = await mkdtemp(join(tmpdir(), 'octo-rust-shortids-'));
+    process.env.RUST_REALITY_BASE_CONFIG = join(dir, 'base.json');
+    process.env.RUST_REALITY_ACTIVE_CONFIG = join(dir, 'active.json');
+    process.env.RUST_REALITY_MANAGEMENT_SOCKET = join(dir, 'management.sock');
+    process.env.RUST_REALITY_CURSOR = join(dir, 'cursor.json');
+    const uuid = '11111111-1111-4111-8111-111111111111';
+    const panel = (shortIds) => ({
+        outbounds: [{ tag: 'DIRECT' }],
+        inbounds: [
+            {
+                tag: 'entry',
+                protocol: 'vless',
+                streamSettings: { security: 'reality', realitySettings: { shortIds } },
+                settings: { clients: [{ email: '5197', id: uuid, flow: 'xtls-rprx-vision' }] },
+            },
+        ],
+    });
+    try {
+        await writeFile(
+            process.env.RUST_REALITY_BASE_CONFIG,
+            JSON.stringify({ role: 'entry', reality: {}, users: [] }),
+        );
+        const service = new RustCoreService();
+        service.isOnline = async () => false;
+        service.writeValidated = async (config) =>
+            writeFile(process.env.RUST_REALITY_ACTIVE_CONFIG, JSON.stringify(config));
+        await service.prepareFromPanel(panel(['aabb', '0123456789abcdef']));
+        const active = JSON.parse(await readFile(process.env.RUST_REALITY_ACTIVE_CONFIG, 'utf8'));
+        assert.deepEqual(active.reality.sharedShortIds, ['aabb', '0123456789abcdef']);
+        assert.deepEqual(
+            active.users.map((user) => user.panelUserId),
+            [5197],
+        );
+        assert.deepEqual(
+            JSON.parse(await readFile(process.env.RUST_REALITY_BASE_CONFIG, 'utf8')).reality,
+            {},
+            'operator template is untouched',
+        );
+        await assert.rejects(service.prepareFromPanel(panel([])), /needs panel REALITY short IDs/);
+        await assert.rejects(service.prepareFromPanel(panel(['not-hex'])), /malformed/);
+    } finally {
+        await rm(dir, { recursive: true, force: true });
+        for (const key of [
+            'RUST_REALITY_BASE_CONFIG',
+            'RUST_REALITY_ACTIVE_CONFIG',
+            'RUST_REALITY_MANAGEMENT_SOCKET',
+            'RUST_REALITY_CURSOR',
+        ])
+            delete process.env[key];
+    }
+});
