+test('health requires a reload acknowledgment after an offline-staged config', async () => {
+    const dir = await mkdtemp(join(tmpdir(), 'octo-rust-health-proof-'));
+    process.env.RUST_REALITY_BASE_CONFIG = join(dir, 'base.json');
+    process.env.RUST_REALITY_ACTIVE_CONFIG = join(dir, 'active.json');
+    process.env.RUST_REALITY_MANAGEMENT_SOCKET = join(dir, 'management.sock');
+    process.env.RUST_REALITY_CURSOR = join(dir, 'cursor.json');
+    const panel = {
+        outbounds: [{ tag: 'DIRECT' }],
+        inbounds: [
+            {
+                tag: 'entry',
+                protocol: 'vless',
+                settings: {
+                    clients: [
+                        {
+                            email: '5197',
+                            id: '11111111-1111-4111-8111-111111111111',
+                            flow: 'xtls-rprx-vision',
+                        },
+                    ],
+                },
+            },
+        ],
+    };
+    try {
+        await writeFile(
+            process.env.RUST_REALITY_BASE_CONFIG,
+            JSON.stringify({ role: 'entry', reality: { sharedShortIds: ['aabb'] }, users: [] }),
+        );
+        const service = new RustCoreService();
+        service.writeValidated = async (config) =>
+            writeFile(process.env.RUST_REALITY_ACTIVE_CONFIG, JSON.stringify(config));
+        service.readSnapshot = async () => ({
+            version: 1,
+            bootId: BOOT,
+            generation: 1,
+            activePanelIds: [5197],
+            users: [],
+        });
+        service.isOnline = async () => false;
+        await service.prepareFromPanel(panel);
+        assert.equal(
+            await service.activeConfigApplied(),
+            false,
+            'identical IDs do not prove an offline-staged UUID was loaded',
+        );
+        service.isOnline = async () => true;
+        let reloads = 0;
+        service.reload = async (ids) => {
+            assert.deepEqual(ids, [5197]);
+            reloads++;
+        };
+        await service.prepareFromPanel(panel);
+        assert.equal(reloads, 1);
+        assert.equal(await service.activeConfigApplied(), true);
+    } finally {
+        await rm(dir, { recursive: true, force: true });
+        for (const key of [
+            'RUST_REALITY_BASE_CONFIG',
+            'RUST_REALITY_ACTIVE_CONFIG',
+            'RUST_REALITY_MANAGEMENT_SOCKET',
+            'RUST_REALITY_CURSOR',
+        ])
+            delete process.env[key];
+    }
+});
